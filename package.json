{
  "name": "ilvox-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend seguro y tipado para la plataforma ILVOX.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:constraint-audit": "node --test scripts/audit-constraint-names.test.mjs",
    "test:database": "node scripts/test-with-database.mjs",
    "test:watch": "vitest",
    "smoke:phase45:public": "node scripts/smoke-phase45-public.mjs",
    "smoke:phase5:operational": "tsx scripts/smoke-phase5-operational.ts",
    "smoke:phase6:operational": "tsx scripts/smoke-phase6-operational.ts",
    "smoke:phase74:portal": "tsx scripts/smoke-phase74-client-portal.ts",
    "smoke:phase75a:internal": "tsx scripts/smoke-phase75a-internal.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:constraint-audit && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:export": "drizzle-kit export",
    "db:check": "drizzle-kit check",
    "db:validate:runtime": "node scripts/database-runtime-validate.mjs",
    "db:validate:phase3": "node scripts/validate-phase3-migrations.mjs",
    "db:validate:phase45": "node scripts/validate-phase45-migrations.mjs",
    "db:validate:phase5-closure": "node scripts/validate-phase5-closure-migrations.mjs",
    "db:validate:phase6": "node scripts/validate-phase6-migrations.mjs",
    "db:operate:phase6": "node scripts/phase6-operational-deploy.mjs",
    "db:operate:phase5": "node scripts/phase5-operational-deploy.mjs",
    "db:check:phase3-cleanup": "node scripts/check-phase3-cleanup.mjs",
    "audit:sql": "node scripts/audit-sql.mjs",
    "audit:rbac": "node scripts/audit-rbac.mjs",
    "audit:parity": "node scripts/audit-drizzle-parity.mjs",
    "audit:constraint-names": "node scripts/audit-constraint-names.mjs",
    "openapi:phase5": "node scripts/generate-phase5-openapi.mjs",
    "openapi:phase6": "node scripts/generate-phase6-openapi.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.12.0",
    "@clerk/fastify": "^3.1.54",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
