# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=false

# HTTP security
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# PostgreSQL. DATABASE_URL es obligatoria en producción.
DATABASE_URL=postgresql://ilvox_user:change_me@127.0.0.1:5432/ilvox
# Base exclusiva para integración y validaciones destructivas. Nunca apuntar a producción.
TEST_DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Clerk. Mantener deshabilitado permite ejecutar pruebas sin credenciales reales.
CLERK_AUTH_ENABLED=false
# Levantar el Relay local con `npm run dev:webhooks`; destino: http://127.0.0.1:3001/webhooks/clerk
CLERK_WEBHOOKS_ENABLED=true
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://localhost:5173
CLERK_AUDIENCE=
# Origen canónico que Clerk usará al construir el redirect de invitaciones.
CLIENT_APP_URL=http://127.0.0.1:5173

# Correo transaccional. `disabled` mantiene leads operativos sin credenciales.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=ILVOX <notificaciones@notify.example.com>
# Uno o varios destinatarios separados por coma.
NOTIFICATION_EMAIL_TO=

# Archivos privados en Cloudflare R2 (S3-compatible). Mantener disabled hasta configurar credenciales.
FILE_STORAGE_PROVIDER=disabled
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FILE_DOCUMENT_MAX_BYTES=26214400
FILE_IMAGE_MAX_BYTES=15728640
FILE_ZIP_MAX_BYTES=104857600
FILE_UPLOAD_URL_TTL_SECONDS=900
FILE_DOWNLOAD_URL_TTL_SECONDS=300
